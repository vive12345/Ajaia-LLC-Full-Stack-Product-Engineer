# Copy this file to .env and fill in real values. Never commit .env.

# Neon Postgres — POOLED connection string (host contains "-pooler"). Used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"

# Neon Postgres — DIRECT (non-pooled) connection string. Used by Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# Secret used to sign session cookies (HMAC). Generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string"
